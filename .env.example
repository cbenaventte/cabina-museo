# Copia este archivo como ".env" y completa la clave. No lo subas a ningún repositorio.

# Clave gratuita de Groq: console.groq.com -> API Keys
GROQ_API_KEY=

# Puerto del Arduino: COM3 en Windows, /dev/ttyUSB0 en Linux (python main.py --list-ports)
CABINA_PORT=COM3

# Parte del nombre de la tarjeta de sonido USB (python main.py --list-audio). Ej: AB13X
CABINA_AUDIO_IN=AB13X
CABINA_AUDIO_OUT=AB13X

# Opcionales (valores por defecto)
# CABINA_VOICE=es-CL-CatalinaNeural
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
